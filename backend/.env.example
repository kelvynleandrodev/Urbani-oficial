# Copie este arquivo para .env e ajuste os valores. O .env NÃO vai para o GitHub.

# Endereço do banco: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql://urbani:urbani@localhost:5432/urbani

# Segredo que assina os tokens de login. Gere um com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Tempo de validade do login, em minutos (480 = 8 horas)
JWT_EXPIRA_MIN=480

# Endereços do front que podem chamar a API (Live Server usa a porta 5500)
CORS_ORIGENS=http://127.0.0.1:5500,http://localhost:5500
